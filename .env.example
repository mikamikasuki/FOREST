# PostgreSQL is recommended for multi-worker use. Leave unset for local SQLite.
# FOREST_DATABASE_URL=postgresql+psycopg://forest:change-me@127.0.0.1:5432/forest
FOREST_DATA_DIR=./var
FOREST_HOST=127.0.0.1
FOREST_PORT=8000
FOREST_WORKER_CONCURRENCY=2
# Optional existing local Ollama model. No paid provider is enabled automatically.
FOREST_OLLAMA_URL=http://127.0.0.1:11434
FOREST_MODEL=qwen2.5:3b
# Optional owner bearer token for authenticated non-loopback deployments.
# FOREST_OWNER_TOKEN=
# Optional polite-pool email for Crossref requests.
# FOREST_CONTACT_EMAIL=
